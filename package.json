{
  "name": "kt-photography",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "bootstrap:admin": "node --env-file=.env.local scripts/bootstrap-admin.mjs",
    "test": "node --env-file=.env.local --test tests/*.test.mjs",
    "test:e2e": "node --env-file=.env.local tests/e2e.mjs",
    "test:photos": "node --env-file=.env.local tests/photo-management.e2e.mjs",
    "test:quotation": "node --test tests/quotation.test.mjs && node tests/quotation.e2e.mjs",
    "format": "prettier --write src scripts tests *.json *.ts *.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "^2.99.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
